+void *nxAudioGPScratch (uint32_t size)
+{
+    const uint32_t max_size = MCPX_HW_GP_SGE_ARRAY_SIZE / sizeof(mcpx_sge_t) * PAGE_SIZE;
+    size = (size + PAGE_SIZE - 1) & ~(PAGE_SIZE - 1);
+    if (!g_hw_gp_scratch || size > max_size) {
+        apu_set_last_error(!g_hw_gp_scratch ? NX_AUDIO_ERR_INVALID_STATE : NX_AUDIO_ERR_INVALID_PARAM);
+        return NULL;
+    }
+    if (size <= g_hw_gp_scratch_size) {
+        return g_hw_gp_scratch;
+    }
+
+    void *scratch = MmAllocateContiguousMemoryEx(size, 0, 0xFFFFFFFF, PAGE_SIZE, PAGE_READWRITE);
+    if (!scratch) {
+        apu_set_last_error(NX_AUDIO_ERR_OUT_OF_MEMORY);
+        return NULL;
+    }
+    memset(scratch, 0, size);
+    memcpy(scratch, g_hw_gp_scratch, g_hw_gp_scratch_size);
+
+    // The GP DMAs through these entries as it runs. Each page holds the same words in either mapping, so a
+    // transfer that sees some of each is still correct.
+    for (uint32_t i = 0; i < size / PAGE_SIZE; i++) {
+        g_hw_gp_sges[i].phys_addr = MmGetPhysicalAddress(scratch) + i * PAGE_SIZE;
+        g_hw_gp_sges[i].length_and_format = PAGE_SIZE;
+    }
+
+    // Let any transfer through the old pages finish before they go. A GP frame is 32 samples, under 1 ms.
+    if (g_hw_gp_scratch != g_hw_gp_pmem) {
+        KeStallExecutionProcessor(2000);
+        MmFreeContiguousMemory(g_hw_gp_scratch);
+    }
+    g_hw_gp_scratch = scratch;
+    g_hw_gp_scratch_size = size;
+    return scratch;
+}
